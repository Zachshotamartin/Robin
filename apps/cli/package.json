{
  "name": "@guard/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line interface for deterministic Guarded Agent runs and policy debugging.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "guard": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "testdata"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --build --force",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@guard/contracts": "0.0.0",
    "@guard/milestone-a-scenarios": "0.0.0",
    "@guard/policy-engine": "0.0.0",
    "@guard/policy-language": "0.0.0"
  }
}
