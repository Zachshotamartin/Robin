{
  "name": "@zachshotamartin/robin",
  "version": "0.0.0",
  "private": true,
  "description": "Robin coding agent CLI for interactive, provider-flexible repository work.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zachshotamartin/Robin.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/Zachshotamartin/Robin/issues"
  },
  "homepage": "https://github.com/Zachshotamartin/Robin#readme",
  "type": "module",
  "bin": {
    "robin": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "testdata"
  ],
  "scripts": {
    "build": "tsc --build && node scripts/ensure-bin-executable.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --build",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@guard/contracts": "0.0.0",
    "@guard/milestone-a-scenarios": "0.0.0",
    "@guard/policy-engine": "0.0.0",
    "@guard/policy-language": "0.0.0",
    "@guard/robin-application": "0.0.0"
  }
}
