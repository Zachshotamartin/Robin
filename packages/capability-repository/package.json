{
  "name": "@guard/capability-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Virtual coding fixture pack for bounded listing, literal search, reads, patch proposals, and diff inspection.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "policies",
    "testdata"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "test": "npm run build && node --test --test-reporter=../../scripts/deterministic-test-reporter.mjs dist/*.test.js"
  },
  "dependencies": {
    "@guard/capability-gateway": "0.0.0",
    "@guard/context-broker": "0.0.0",
    "@guard/contracts": "0.0.0",
    "@guard/policy-engine": "0.0.0"
  }
}
